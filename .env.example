# Configuración de Firebase para Producción / Desarrollo Conectado
# Copia este archivo como .env.local y completa los valores de tu proyecto Firebase
# Si estas variables no están definidas, la aplicación iniciará automáticamente en
# MODO DEMOSTRACIÓN LOCAL (claramente identificado en pantalla) con sincronización
# multi-pestaña (BroadcastChannel + LocalStorage) y los 35 pilotos de prueba.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Opcional: Usar Firebase Local Emulator Suite (true / false)
VITE_USE_FIREBASE_EMULATOR=false
